<%# Inline navigation rendered inside the site header, on the same row as the
    title and the dark-mode toggle. Top-level items render in a row; items with
    children open a dropdown on hover or click. %>
<nav>
  <ul role="list" class="flex items-center gap-x-1">
    <% current_menu.items(self).each do |item| %>
      <% children = item.items(self).presence %>
      <% url = item.url(self) %>
      <li class="group relative" data-item-id="<%= item.id %>">
        <% if children %>
          <button data-menu-button class="flex items-center gap-x-1 rounded-md px-3 py-3 text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white" aria-label="<%= t('active_admin.toggle_section') %>">
            <%= item.label(self) %>
            <svg class="h-4 w-4 shrink-0 group-data-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          <ul role="list" class="absolute start-0 top-full z-40 hidden min-w-48 rounded-md border border-gray-200 dark:border-white/10 bg-white dark:bg-gray-950 py-1 shadow-lg group-hover:block group-data-open:block">
            <% children.each do |j| %>
              <li data-item-id="<%= j.id %>">
                <%= link_to j.label(self), j.url(self), j.html_options.merge(class: "block px-3 py-2 text-sm no-underline text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-white #{(current_menu_item?(j) ? "bg-gray-100 dark:bg-white/5 text-gray-900 dark:text-white selected" : "")}") %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <%= link_to item.label(self), url, item.html_options.merge(class: "block rounded-md px-3 py-3 text-sm no-underline text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white #{(current_menu_item?(item, children: false) ? "bg-gray-100 dark:bg-white/5 text-gray-900 dark:text-white selected" : "")}") %>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
